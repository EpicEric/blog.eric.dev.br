---
import { site } from '../data/site';
import type { Locale } from '../data/site';
import { countLabel, t } from '../i18n/ui';
import { getPosts } from '../lib/posts';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const posts = await getPosts(locale);
const alternatePath = locale === 'en' ? '/pt-BR/' : '/';
const feed = locale === 'en' ? '/rss.xml' : `/${locale}/rss.xml`;
---

<BaseLayout
  title={site.title[locale]}
  description={site.intro[locale]}
  locale={locale}
  alternatePath={alternatePath}
  section="index"
>
  <div class="page-intro">
    <h1>{site.title[locale]}</h1>
    <div class="page-intro__copy">
      <p>{site.intro[locale]}</p>
    </div>
  </div>

  <section class="directory" aria-labelledby="latest-heading">
    <div class="section-head">
      <h2 id="latest-heading">{t(locale, 'index.latest')}</h2>
      <span>{countLabel(locale, posts.length)}</span>
    </div>

    {
      posts.length > 0 ? (
        <PostList posts={posts} locale={locale} />
      ) : (
        <p class="empty-state">{t(locale, 'index.empty')}</p>
      )
    }
  </section>
</BaseLayout>
