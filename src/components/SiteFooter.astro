---
import { site } from '../data/site';
import type { Locale } from '../data/site';
import { t } from '../i18n/ui';
import SocialIcon from './SocialIcon.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="machine__base">
  <div class="ports">
    <span class="ports__label">{t(locale, 'footer.ports')}</span>
    <ul class="ports__list">
      {
        site.socials.map((social) => (
          <li>
            <a
              class="port"
              href={social.href}
              rel="noopener me"
              target="_blank"
            >
              <SocialIcon name={social.key} size={16} />
              <span>{social.label}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="colophon">
    <p>
      © {year === 2026 ? year : `2026—${year}`} {site.author}.
    </p>
    <p class="colophon__meta">
      <a href="https://git.eric.dev.br/EpicEric/blog.eric.dev.br" rel="noopener" target="_blank">{t(locale, 'footer.built')}</a>
      <span aria-hidden="true">·</span>
      <a href={site.url} rel="noopener me" target="_blank">{site.url.replace('https://', '')}</a>
    </p>
  </div>
</footer>
