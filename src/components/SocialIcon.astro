---
import { siCodeberg, siGithub, siKofi, siMastodon } from 'simple-icons';
import type { SocialKey } from '../data/site';

interface Props {
  name: SocialKey;
  size?: number;
}

const { name, size = 18 } = Astro.props;

const brand = {
  github: siGithub,
  codeberg: siCodeberg,
  mastodon: siMastodon,
  kofi: siKofi,
} as const;

const icon = name === 'website' ? undefined : brand[name];
---

{
  icon ? (
    <svg
      width={size}
      height={size}
      viewBox="0 0 24 24"
      aria-hidden="true"
      focusable="false"
      fill="currentColor"
    >
      <path d={icon.path} />
    </svg>
  ) : (
    <svg
      width={size}
      height={size}
      viewBox="0 0 24 24"
      aria-hidden="true"
      focusable="false"
      fill="none"
      stroke="currentColor"
      stroke-width="1.7"
      stroke-linecap="round"
    >
      <circle cx="12" cy="12" r="8.25" />
      <path d="M3.9 12h16.2M12 3.75c2.2 2.2 3.35 5 3.35 8.25S14.2 18.05 12 20.25c-2.2-2.2-3.35-5-3.35-8.25S9.8 5.95 12 3.75Z" />
    </svg>
  )
}
